# Mac demo Agent profile. Copy to .env.mac and replace every placeholder.
FOWOCO_APP_ENV=demo
FOWOCO_DEBUG=false

# A public tunnel must never point to an unauthenticated Agent.
FOWOCO_INTERNAL_API_AUTH_REQUIRED=true
FOWOCO_INTERNAL_API_TOKEN=

# BERT + A.X hybrid Intent runtime
FOWOCO_INTENT_MODEL_ENABLED=true
FOWOCO_INTENT_BERT_MODEL_DIR=fowoco/klue-roberta-base-intent-classifier
FOWOCO_INTENT_BERT_MODEL_REVISION=54418463823b68689252b50cb1626bdb67f7da82
FOWOCO_INTENT_ENABLE_AX=true
FOWOCO_INTENT_AX_BASE_MODEL=skt/A.X-4.0-Light
FOWOCO_INTENT_AX_BASE_REVISION=ba21c20ea1b31ded1ec3e2fb432335077dc4be98
FOWOCO_INTENT_AX_ADAPTER_PATH=fowoco/ax-intent-qlora
FOWOCO_INTENT_AX_ADAPTER_REVISION=bb78d8d022391b0a3c81178d2b0f6dbad1cb8364
FOWOCO_INTENT_DEVICE=mps
FOWOCO_INTENT_WARMUP_ON_START=true
FOWOCO_INTENT_WARMUP_REQUIRED=true

# Create a new read-only token. Never commit the real value.
FOWOCO_HF_TOKEN=

# Keep unrelated providers disabled unless the demo needs them.
FOWOCO_CLOVA_OCR_ENABLED=false
