# FOWOCO AI Agent Server Environment Template
# Copy this file to .env and fill in your secrets before running:
# cp .env.example .env

# Server Basic Settings
FOWOCO_APP_NAME=fowoco-ai
FOWOCO_APP_ENV=development
FOWOCO_DEBUG=true
FOWOCO_HOST=0.0.0.0
FOWOCO_PORT=8000
FOWOCO_INTERNAL_API_TOKEN=your-internal-bearer-token-here

# Vector DB (Qdrant) Configuration
FOWOCO_QDRANT_URL=http://qdrant:6333
FOWOCO_QDRANT_API_KEY=
FOWOCO_QDRANT_COLLECTION_ALIAS=eps_language_phrases_active

# LLM Configuration (OpenAI-compatible)
FOWOCO_LLM_PROVIDER=openai-compatible
FOWOCO_LLM_BASE_URL=https://api.openai.com/v1
FOWOCO_LLM_API_KEY=your-openai-api-key-here
FOWOCO_LLM_MODEL=gpt-4o-mini
FOWOCO_LLM_TIMEOUT_SECONDS=30

# CLOVA OCR Settings (Optional)
FOWOCO_CLOVA_OCR_ENABLED=false
FOWOCO_CLOVA_OCR_INVOKE_URL=
FOWOCO_CLOVA_OCR_SECRET=
FOWOCO_CLOVA_OCR_TIMEOUT_SECONDS=30.0
FOWOCO_CLOVA_OCR_CONFIDENCE_THRESHOLD=0.80
