# ==============================================================================
# FOWOCO AI Agent Server — Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Language Assistant — LLM 연동 설정 (OpenAI 호환)
# ------------------------------------------------------------------------------
# LLM 프로토콜 (미설정 시 API 호출 시 503 반환)
FOWOCO_LLM_PROVIDER=openai-compatible

# OpenAI API 호스트 주소
FOWOCO_LLM_BASE_URL=https://api.openai.com/v1

# OpenAI API 발급 키 (sk-proj-...) — 실제 키로 교체 필요
FOWOCO_LLM_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE

# 사용할 LLM 모델명
FOWOCO_LLM_MODEL=gpt-5.6-luna

# LLM 요청 대기 타임아웃 (초 단위, 기본 60초)
FOWOCO_LLM_TIMEOUT_SECONDS=60

# ------------------------------------------------------------------------------
# 2. Language Assistant — VectorDB 연동 설정 (Qdrant)
# ------------------------------------------------------------------------------
# Qdrant 서버 주소 (미설정 시 일반 LLM 번역으로 Fallback 동작)
FOWOCO_QDRANT_URL=http://localhost:6333

# ------------------------------------------------------------------------------
# 3. Internal API — Server ↔ AI 인증
# ------------------------------------------------------------------------------
# Internal API Bearer — 비우면 로컬 인증 생략, 단 OCR 활성화 시 필수
# FOWOCO_INTERNAL_API_TOKEN=

# ------------------------------------------------------------------------------
# 4. Intent — HF 하이브리드 분류기 설정 (opt-in, 기본 false면 EXPIRY_RENEWAL 고정 stub)
# ------------------------------------------------------------------------------
FOWOCO_INTENT_MODEL_ENABLED=false
FOWOCO_INTENT_BERT_MODEL_DIR=fowoco/klue-roberta-base-intent-classifier
# 운영에서는 mutable branch명이 아닌 Hugging Face commit SHA로 고정
# FOWOCO_INTENT_BERT_MODEL_REVISION=<commit-sha>
FOWOCO_INTENT_AX_BASE_MODEL=skt/A.X-4.0-Light
# FOWOCO_INTENT_AX_BASE_REVISION=<commit-sha>
FOWOCO_INTENT_AX_ADAPTER_PATH=fowoco/ax-intent-qlora
# FOWOCO_INTENT_AX_ADAPTER_REVISION=<commit-sha>
FOWOCO_INTENT_ENABLE_AX=false
FOWOCO_INTENT_DEVICE=cpu
# 운영에서는 트래픽 수신 전에 모델 로딩·첫 추론 완료
FOWOCO_INTENT_WARMUP_ON_START=true
FOWOCO_INTENT_WARMUP_REQUIRED=false

# 비공개 HF 모델 접근용 토큰 (실제 토큰으로 교체 필요)
FOWOCO_HF_TOKEN=hf_YOUR_HUGGINGFACE_TOKEN_HERE

# ------------------------------------------------------------------------------
# 5. CLOVA Template OCR — Stateless 내부 API
# ------------------------------------------------------------------------------
# false이면 OCR API가 503을 반환하며 외부 HTTP client를 생성하지 않음
FOWOCO_CLOVA_OCR_ENABLED=false

# CLOVA Template OCR Invoke URL과 인증 secret
FOWOCO_CLOVA_OCR_INVOKE_URL=https://example.invalid/clova-template-ocr
FOWOCO_CLOVA_OCR_SECRET=replace-with-clova-secret

# Provider timeout(초)과 REVIEW_REQUIRED 판단 신뢰도 기준
FOWOCO_CLOVA_OCR_TIMEOUT_SECONDS=30
FOWOCO_CLOVA_OCR_CONFIDENCE_THRESHOLD=0.80
