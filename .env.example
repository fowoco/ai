# ==============================================================================
# FOWOCO AI Agent Server — Integrated Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Core & Authentication
# ------------------------------------------------------------------------------
FOWOCO_APP_NAME=fowoco-ai
FOWOCO_APP_ENV=development
FOWOCO_DEBUG=true
FOWOCO_HOST=0.0.0.0
FOWOCO_PORT=8000

# AI internal endpoint authentication (Internal API JWT Token)
FOWOCO_INTERNAL_API_TOKEN=your-internal-api-token-here

# Restricted PostgreSQL role used by the AI repository
FOWOCO_DATABASE_URL=postgresql://user:password@localhost:5432/fowoco_db

# ------------------------------------------------------------------------------
# 2. Language Assistant Agent (LLM & Qdrant VectorDB)
# ------------------------------------------------------------------------------
# LLM Protocol (openai-compatible)
FOWOCO_LLM_PROVIDER=openai-compatible
FOWOCO_LLM_BASE_URL=https://api.openai.com/v1
FOWOCO_LLM_API_KEY=sk-proj-YOUR_OPENAI_API_KEY_HERE
FOWOCO_LLM_MODEL=gpt-5.6-luna
FOWOCO_LLM_TIMEOUT_SECONDS=60

# Qdrant VectorDB (미설정 시 일반 LLM 번역으로 Fallback 동작)
FOWOCO_QDRANT_URL=http://localhost:6333
FOWOCO_QDRANT_API_KEY=
FOWOCO_QDRANT_COLLECTION_ALIAS=eps_language_phrases_active

# ------------------------------------------------------------------------------
# 3. CLOVA Template OCR
# ------------------------------------------------------------------------------
# Fill the secret, internal token, and database URL locally before enabling OCR.
FOWOCO_CLOVA_OCR_ENABLED=false
FOWOCO_CLOVA_OCR_INVOKE_URL=https://vc0vyndga3.apigw.ntruss.com/custom/v1/56503/f059ae7bb5716c14e8985ced67967d939b06c90b2fa296120c032a240497b283/infer
FOWOCO_CLOVA_OCR_SECRET=YOUR_CLOVA_OCR_SECRET_HERE
FOWOCO_CLOVA_OCR_TIMEOUT_SECONDS=30
FOWOCO_CLOVA_OCR_CONFIDENCE_THRESHOLD=0.80
